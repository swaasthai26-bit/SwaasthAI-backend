NODE_ENV=development
PORT=4000
SERVER_URL=http://localhost:4000

# Database
MONGODB_URI=mongodb://localhost:27017/swaasthai
REDIS_URL=redis://localhost:6379

# JWT — rotate quarterly in production (SRS NFR-SEC3). MUST be set in prod.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# SMS providers (SRS §13.6). MVP uses a console adapter until DLT templates
# are approved; production must set these and switch the adapter in bootstrap.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
FAST2SMS_API_KEY=
